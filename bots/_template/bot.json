{
  "name": "Example bot",
  "description": "Copy this folder to bots/<your-id>/ (no leading underscore) to create a bot.",
  "enabled": false,
  "model": "claude-haiku-5-5",
  "triggers": ["!example"],
  "dm": "organizers",
  "mcpServers": {
    "myserver": { "url": "${MYSERVER_MCP_URL}", "tokens": { "organizer": "${MYSERVER_TOKEN}" } }
  },
  "tools": {
    "participant": ["myserver:read_*"],
    "organizer": ["myserver:*"],
    "deny": ["myserver:delete_*"]
  },
  "confirm": null,
  "schedules": []
}
