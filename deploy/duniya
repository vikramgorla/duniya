#!/bin/bash
# `duniya` command for installer servers (029), installed to /usr/local/bin/duniya by install.sh.
# Runs bin/duniya.js as the app user with the app's environment, so files in the data directory keep the right
# owner. Things that need root (restarting the service, reading its log, finishing an update) happen here.
set -uo pipefail
APP_DIR="${DUNIYA_APP_DIR:-/opt/whatsapp-agent-duniya}"
ENV_FILE="${DUNIYA_ENV_FILE:-/etc/duniya/app.env}"
APP_USER="${DUNIYA_APP_USER:-duniya}"
SERVICE=whatsapp-agent-duniya

if [ "$(id -u)" -ne 0 ]; then
  if command -v sudo >/dev/null; then exec sudo "$0" "$@"; fi
  echo "Run this as root: sudo duniya $*" >&2; exit 1
fi
[ -f "$APP_DIR/bin/duniya.js" ] || { echo "Duniya is not installed in $APP_DIR (or is too old for this command: re-run the installer)." >&2; exit 1; }

run_app() { # run bin/duniya.js as the app user with only the app's environment
  local envs=() line
  if [ -r "$ENV_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && envs+=("$line")
    done < "$ENV_FILE"
  fi
  local base=(env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/var/lib/duniya LANG="${LANG:-C.UTF-8}" TERM="${TERM:-dumb}" "${envs[@]}" DUNIYA_WRAPPER=1
    node --disable-warning=ExperimentalWarning "$APP_DIR/bin/duniya.js" "$@")
  cd "$APP_DIR" || return 1
  if command -v runuser >/dev/null; then runuser -u "$APP_USER" -- "${base[@]}"; else sudo -u "$APP_USER" -- "${base[@]}"; fi
}

# #96: the in-panel app update runs as the app user, so it cannot (and must not) replace the root maintenance helper.
# After `sudo duniya update` (or when already up to date) copy the helper from the checkout, as the installer does,
# but only when those files are exactly as committed (git runs as the app user, never as root in its repository).
refresh_helper() {
  local ops="$APP_DIR/deploy/ops" f changed=0
  [ -f "$ops/duniya-ops" ] && [ -d /var/lib/duniya-ops ] || return 0
  if ! (cd "$APP_DIR" && runuser -u "$APP_USER" -- git diff --quiet HEAD -- deploy/ops) 2>/dev/null; then
    echo "! Not updating the maintenance helper: deploy/ops has local changes. Re-run the installer to repair." >&2; return 0
  fi
  for f in duniya-ops:/usr/local/sbin/duniya-ops:0755 duniya-ops.service:/etc/systemd/system/duniya-ops.service:0644 \
    duniya-ops.path:/etc/systemd/system/duniya-ops.path:0644 webconfig.mjs:/usr/local/lib/duniya-ops/webconfig.mjs:0644; do
    IFS=: read -r src dst mode <<< "$f"
    [ -f "$ops/$src" ] || continue
    if ! cmp -s "$ops/$src" "$dst"; then install -D -m "$mode" -o root -g root "$ops/$src" "$dst"; changed=1; fi
  done
  if [ "$changed" = 1 ]; then systemctl daemon-reload; systemctl enable -q --now duniya-ops.path; echo "✓ Maintenance helper updated."; fi
}

case "${1:-}" in
  restart)
    echo "Restarting $SERVICE (agents are offline for a few seconds)…"
    systemctl restart "$SERVICE" && sleep 2 && systemctl is-active -q "$SERVICE" && echo "✓ Restarted." || { echo "✗ The service did not come back. See: duniya logs" >&2; exit 1; }
    ;;
  logs)
    shift
    args=(-u "$SERVICE" -n 200 --no-pager -o short-iso)
    for a in "$@"; do case "$a" in -f|--follow) args+=(-f) ;; esac; done
    exec journalctl "${args[@]}"
    ;;
  update)
    if [[ " $* " == *" --check "* ]]; then run_app "$@"; exit $?; fi
    run_app "$@"; rc=$?
    case $rc in
      0) refresh_helper; systemctl restart "$SERVICE" && echo "✓ Restarted on the new version." ;;
      3) refresh_helper; exit 0 ;; # already up to date (perhaps updated from the panel): still refresh the helper
      *) exit $rc ;;
    esac
    ;;
  *) run_app "$@"; exit $? ;;
esac
