#!/bin/bash
# duniya-ops-version: 3
# Root maintenance helper for whatsapp-agent-duniya (installed to /usr/local/sbin/duniya-ops by install.sh).
# Started by duniya-ops.path when the app writes an action word to the request file. Accepts ONLY the actions
# below; never executes anything taken from the request beyond matching it against this list.
#
# apply-web-config (031): reads web-config.json written by the app, validates and renders it with the root-owned
# copy of webconfig.mjs (never the app's own code), checks it with `caddy validate`, reloads Caddy, waits for HTTPS
# and rolls back to the previous Caddyfile if it does not come up. On success PUBLIC_URL/TRUST_PROXY are updated.
# The HTTPS check goes to 127.0.0.1 with each served address as SNI/Host (never through public DNS), so an address
# behind a proxy/CDN is checked on this server itself. Behind a proxy (036) Caddy may first serve its internal
# fallback certificate, so for those addresses any certificate is accepted; a direct address needs a real one.
#
# os-update / os-update-all (#96): `apt-get full-upgrade` (kept-back kernel meta-packages install too), then
# `autoremove --purge` (apt keeps the running kernel). Ubuntu's phased updates are respected unless the owner chose
# os-update-all. "== step: …" lines mark each apt step so the app can summarise the run. The version line at the
# top tells the app which actions this copy understands (the in-panel app update cannot replace this root file).
#
# update-helper (056, version 3): this helper replaces itself (and its units and webconfig.mjs) with the copy from an
# official release, so owners without SSH never need `sudo duniya update`. Root never runs the app's own checkout:
# it fetches the repository itself over HTTPS (TLS verified) into a root-owned directory, from the URL in the
# root-owned install config (or the official one), never from the app. The app only names the release (helper-version,
# strictly vX.Y.Z); releases older than the first self-updating one or than the last one installed are refused, and so
# is a fetched helper with a lower version line (no downgrades). Shallow and blobless: only deploy/ops is downloaded.
set -uo pipefail
# Paths can be overridden for the automated tests only (systemd starts this with a clean environment).
REQ_DIR=${DUNIYA_OPS_REQUEST_DIR:-/var/lib/duniya/ops-request}
STATE_DIR=${DUNIYA_OPS_STATE_DIR:-/var/lib/duniya-ops}
REQ="$REQ_DIR/request"
WEBCONFIG=${DUNIYA_OPS_WEBCONFIG:-/usr/local/lib/duniya-ops/webconfig.mjs}
CADDYFILE=${DUNIYA_OPS_CADDYFILE:-/etc/caddy/Caddyfile}
APP_ENV=${DUNIYA_OPS_APP_ENV:-/etc/duniya/app.env}
INSTALL_CONF=${DUNIYA_OPS_INSTALL_CONF:-/etc/duniya/install.conf}
HTTPS_WAIT=${DUNIYA_HTTPS_WAIT:-240}
HTTPS_POLL=${DUNIYA_HTTPS_POLL:-5}
REBOOT_FILE=${DUNIYA_REBOOT_REQUIRED_FILE:-/var/run/reboot-required}
APT_GET=${DUNIYA_OPS_APT_GET:-apt-get}
DPKG=${DUNIYA_OPS_DPKG:-dpkg}
# update-helper (056): where the helper's files go; the repository override is for the automated tests only.
OPS_SBIN=${DUNIYA_OPS_SBIN:-/usr/local/sbin/duniya-ops}
UNIT_DIR=${DUNIYA_OPS_UNIT_DIR:-/etc/systemd/system}
REPO_OVERRIDE=${DUNIYA_OPS_REPO:-}
OFFICIAL_REPO=https://github.com/vikramgorla/duniya.git
HELPER_MIN_RELEASE=v2.17.0 # the first release whose helper can update itself
SELF_VERSION="$(sed -n 's/^# duniya-ops-version: \([0-9][0-9]*\)$/\1/p' "${BASH_SOURCE[0]}" 2>/dev/null | head -n1)"
SELF_VERSION=${SELF_VERSION:-0}
install -d -m 755 "$STATE_DIR"
[ -f "$REQ" ] || exit 0
# Read at most one short line; ignore anything that is not a known action (do not echo unknown content).
ACTION="$(head -c 32 "$REQ" 2>/dev/null | head -n1 | tr -cd 'a-z-')"
rm -f "$REQ"
case "$ACTION" in os-update|os-update-all|os-cleanup|restart-web|restart-tunnel|reboot|apply-web-config|update-helper) ;; *) exit 0 ;; esac

LOG="$STATE_DIR/last.log"
STATUS="$STATE_DIR/status.json"
WEB_STATUS="$STATE_DIR/web-status.json"
now() { date +%s%3N; }
START=$(now)
write_status() { # state code
  printf '{"action":"%s","state":"%s","code":%s,"startedAt":%s,"endedAt":%s}\n' "$ACTION" "$1" "${2:-null}" "$START" "$([ "$1" = running ] && echo null || now)" > "$STATUS.tmp"
  chmod 644 "$STATUS.tmp"; mv -f "$STATUS.tmp" "$STATUS"
}
# web_status STATE "message" [host] — message and host are fixed strings or validated values (no request content).
web_status() {
  local msg
  msg="$(printf '%s' "$2" | tr -d '\000-\037' | tr -cd "[:alnum:] .,:;/()_@+'=-" | head -c 400)"
  printf '{"state":"%s","message":"%s","host":"%s","startedAt":%s,"endedAt":%s,"at":%s}\n' "$1" "$msg" "${3:-}" "$START" \
    "$(case "$1" in running|waiting) echo null ;; *) now ;; esac)" "$(now)" > "$WEB_STATUS.tmp"
  chmod 644 "$WEB_STATUS.tmp"; mv -f "$WEB_STATUS.tmp" "$WEB_STATUS"
}
set_kv() { # file KEY VALUE — VALUE is validated by webconfig.mjs ([a-z0-9.:/-] only)
  local f="$1" k="$2" v="$3"
  [ -f "$f" ] || return 0
  if grep -q "^$k=" "$f"; then sed -i "s|^$k=.*|$k=$v|" "$f"; else echo "$k=$v" >> "$f"; fi
}

apply_web_config() {
  local work="$STATE_DIR/web-work" caddy_ver out host="" public_url="" trust="" exposure="" strict="" proxied=""
  rm -rf "$work"; install -d -m 700 "$work"
  web_status running "Checking the new settings"
  local node_bin
  node_bin="$(command -v node)" || { echo "Node.js is missing"; web_status failed "Node.js is missing on this server"; return 1; }
  [ -f "$WEBCONFIG" ] || { echo "$WEBCONFIG is missing: re-run the installer once"; web_status failed "This server needs a one-time update: re-run the installer"; return 1; }
  command -v caddy >/dev/null || { echo "Caddy is not installed"; web_status failed "The web server (Caddy) is not installed. Re-run the installer with --ip-https or --domain"; return 1; }
  # Copy the request out of the app-writable directory first (size-limited), then only ever read the copy.
  head -c 262144 "$REQ_DIR/web-config.json" > "$work/request.json" 2>/dev/null || { web_status failed "No settings were sent"; return 1; }
  rm -f "$REQ_DIR/web-config.json"
  caddy_ver="$(caddy version 2>/dev/null | awk '{print $1}' | tr -cd 'v0-9.')"
  echo "Web server: Caddy ${caddy_ver:-unknown}"
  if ! out="$(cd / && env -i PATH=/usr/bin:/bin "$node_bin" "$WEBCONFIG" render "$work/request.json" --out "$work/Caddyfile" --caddy-version "${caddy_ver:-2.6.0}" 2>&1)"; then
    echo "$out"; web_status failed "The settings were refused: ${out#invalid web config: }"; return 1
  fi
  while IFS='=' read -r k v; do
    [[ "$v" =~ ^[a-z0-9.:/,-]+$ ]] || continue
    case "$k" in HOST) host="$v" ;; PUBLIC_URL) public_url="$v" ;; TRUST_PROXY) trust="$v" ;; EXPOSURE) exposure="$v" ;;
      CHECK_STRICT) strict="${v//,/ }" ;; CHECK_PROXIED) proxied="${v//,/ }" ;; esac
  done <<< "$out"
  [ -n "$host" ] || { web_status failed "The settings were refused"; return 1; }
  echo "New address: https://$host"
  if ! caddy validate --adapter caddyfile --config "$work/Caddyfile" >> "$work/validate.log" 2>&1; then
    tail -n 20 "$work/validate.log"; web_status failed "The web server did not accept the new configuration (nothing changed)" "$host"; return 1
  fi
  # Keep the current config as the rollback point; the last config that worked is kept as Caddyfile.last-good.
  cp -f "$CADDYFILE" "$STATE_DIR/Caddyfile.prev" 2>/dev/null || true
  install -m 0644 "$work/Caddyfile" "$CADDYFILE"
  if ! systemctl reload caddy 2>>"$work/validate.log" && ! systemctl restart caddy; then
    rollback "$host" "The web server did not take the new configuration"; return 1
  fi
  [ "$strict" = - ] && strict=""; [ "$proxied" = - ] && proxied=""
  web_status waiting "Getting the HTTPS certificate for $host" "$host"
  echo "Waiting up to $HTTPS_WAIT s for HTTPS on: ${strict:+$strict (real certificate) }${proxied:+$proxied (behind a proxy)}"
  local t0 ok=0 h pending
  t0=$(date +%s)
  while [ $(( $(date +%s) - t0 )) -lt "$HTTPS_WAIT" ]; do
    pending=0
    for h in $strict; do
      curl -fsS --noproxy '*' --max-time 10 -o /dev/null --resolve "$h:443:127.0.0.1" "https://$h/healthz" 2>/dev/null || pending=1
    done
    for h in $proxied; do
      curl -fsSk --noproxy '*' --max-time 10 -o /dev/null --resolve "$h:443:127.0.0.1" "https://$h/healthz" 2>/dev/null || pending=1
    done
    if [ "$pending" -eq 0 ]; then ok=1; break; fi
    sleep "$HTTPS_POLL"
  done
  if [ "$ok" -ne 1 ]; then
    journalctl -u caddy -n 15 --no-pager 2>/dev/null | sed 's/^/  caddy: /'
    rollback "$host" "HTTPS did not come up for $host within $((HTTPS_WAIT / 60)) minutes, so the previous address was restored. Check the DNS record and that ports 80 and 443 are open"
    return 1
  fi
  cp -f "$CADDYFILE" "$STATE_DIR/Caddyfile.last-good"
  install -m 0644 "$work/request.json" "$STATE_DIR/web-applied.json"
  # Public root of Caddy's internal CA, so the app can verify the temporary certificate without disabling validation.
  root_crt=/var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt
  if [ -f "$root_crt" ]; then install -m 0644 "$root_crt" "$STATE_DIR/caddy-local-root.crt"; fi
  set_kv "$APP_ENV" PUBLIC_URL "$public_url"
  set_kv "$APP_ENV" TRUST_PROXY "$trust"
  set_kv "$APP_ENV" DUNIYA_EXPOSURE "$exposure"
  set_kv "$INSTALL_CONF" EXPOSURE "'$exposure'"
  [ "$exposure" = domain ] && set_kv "$INSTALL_CONF" DOMAIN "'$host'"
  echo "HTTPS works at https://$host"
  web_status 'done' "Live at https://$host" "$host"
  rm -rf "$work"
  return 0
}
os_update() { # [phased] — "phased" also installs updates Ubuntu is still rolling out gradually
  local extra=() mem
  [ "${1:-}" = phased ] && extra=(-o APT::Get::Always-Include-Phased-Updates=true)
  # Small servers: apt and dpkg need a few hundred MB while unpacking a kernel. With swap (the installer adds 2 GB on
  # small VMs) it works, just slower; without it the kernel may stop apt. Run at low priority so agents keep answering.
  mem=$(awk '/^MemAvailable:|^SwapFree:/ {s+=$2} END {print int(s/1024)}' /proc/meminfo 2>/dev/null || echo 0)
  if [ "${mem:-0}" -lt 300 ]; then echo "Note: only ${mem} MB of memory and swap free; this can take a while on a small server."; fi
  echo "== step: update"
  "${APT[@]}" update || return $?
  # A run that was cut off earlier (reboot, out of memory) leaves dpkg half-done: finish it first.
  "$DPKG" --force-confdef --force-confold --configure -a || true
  echo "== step: full-upgrade"
  echo "+ apt-get full-upgrade ${extra[*]}"
  "${NICE[@]}" "${APT[@]}" "${extra[@]}" full-upgrade || return $?
  echo "== step: autoremove"
  "${NICE[@]}" "${APT[@]}" autoremove --purge || return $?
  "$APT_GET" clean 2>/dev/null || true
}
version_lt() { # a b — true when release a is older than release b (both vX.Y.Z)
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "${1#v}" "${2#v}" | sort -V | head -n1)" = "${1#v}" ]
}
helper_repo() { # the repository to fetch from: root-owned install config (https only), else the official one
  local r=""
  if [ -n "$REPO_OVERRIDE" ]; then echo "$REPO_OVERRIDE"; return 0; fi
  [ -f "$INSTALL_CONF" ] && r="$(sed -n "s/^REPO='\(.*\)'$/\1/p" "$INSTALL_CONF" | head -n1)"
  if [[ "$r" =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~-]+)+/?$ ]]; then echo "$r"; else echo "$OFFICIAL_REPO"; fi
}
update_helper() {
  local tag floor last repo src="$STATE_DIR/src" newv f dst mode changed=0
  # The app names the release; read at most one short line from its directory and accept only vX.Y.Z.
  tag="$(head -c 32 "$REQ_DIR/helper-version" 2>/dev/null | head -n1 | tr -d '\r ')"
  rm -f "$REQ_DIR/helper-version"
  if ! [[ "$tag" =~ ^v[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4}$ ]]; then echo "Refused: the requested version is not a release number (vX.Y.Z)"; return 2; fi
  floor="$HELPER_MIN_RELEASE"
  last="$(head -c 32 "$STATE_DIR/helper-release" 2>/dev/null | head -n1)"
  if [[ "$last" =~ ^v[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4}$ ]] && version_lt "$floor" "$last"; then floor="$last"; fi
  if version_lt "$tag" "$floor"; then echo "Refused: $tag is older than $floor (the helper is never downgraded)"; return 2; fi
  repo="$(helper_repo)"
  echo "== step: fetch"
  echo "Fetching the maintenance helper of $tag from $repo"
  rm -rf "$src"; install -d -m 700 "$src"
  # git runs as root only in this root-owned directory: clean environment, no system/user config, no hooks, HTTPS
  # only (with certificate checks), one tag, no history and no file contents except the few read below.
  local protos=(-c protocol.allow=never -c protocol.https.allow=always)
  [ -n "$REPO_OVERRIDE" ] && protos=(-c protocol.allow=always) # tests: a local bare repository
  local G=(env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$src" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0
    timeout 300 git -C "$src" -c http.sslVerify=true -c core.hooksPath=/dev/null -c credential.helper= "${protos[@]}")
  "${G[@]}" init -q || return 1
  "${G[@]}" remote add origin "$repo" || return 1
  if ! "${G[@]}" fetch -q --depth 1 --filter=blob:none --no-tags origin "+refs/tags/$tag:refs/tags/$tag"; then
    echo "Could not fetch $tag (is it a published release? is the server online?)"; rm -rf "$src"; return 1
  fi
  install -d -m 700 "$src/out"
  for f in duniya-ops duniya-ops.service duniya-ops.path webconfig.mjs; do
    if ! "${G[@]}" show "refs/tags/$tag:deploy/ops/$f" > "$src/out/$f" 2>/dev/null || [ ! -s "$src/out/$f" ]; then
      echo "Refused: $tag has no deploy/ops/$f"; rm -rf "$src"; return 1
    fi
  done
  echo "== step: check"
  newv="$(sed -n 's/^# duniya-ops-version: \([0-9][0-9]*\)$/\1/p' "$src/out/duniya-ops" | head -n1)"
  if [ "$(head -n1 "$src/out/duniya-ops")" != '#!/bin/bash' ] || [ -z "$newv" ] || ! bash -n "$src/out/duniya-ops"; then
    echo "Refused: the helper in $tag does not look right"; rm -rf "$src"; return 1
  fi
  if [ "$newv" -lt "$SELF_VERSION" ]; then echo "Refused: $tag has helper version $newv, older than this one ($SELF_VERSION)"; rm -rf "$src"; return 2; fi
  echo "== step: install"
  for f in "duniya-ops:$OPS_SBIN:0755" "duniya-ops.service:$UNIT_DIR/duniya-ops.service:0644" \
    "duniya-ops.path:$UNIT_DIR/duniya-ops.path:0644" "webconfig.mjs:$WEBCONFIG:0644"; do
    IFS=: read -r f dst mode <<< "$f"
    cmp -s "$src/out/$f" "$dst" && continue
    # A new file renamed into place: this running script keeps reading its own (old) copy.
    install -D -m "$mode" "$src/out/$f" "$dst.duniya-new" && mv -f "$dst.duniya-new" "$dst" || { echo "Could not install $dst"; return 1; }
    echo "Updated $dst"; changed=1
  done
  rm -rf "$src"
  printf '%s\n' "$tag" > "$STATE_DIR/helper-release"; chmod 644 "$STATE_DIR/helper-release"
  if [ "$changed" = 1 ]; then
    systemctl daemon-reload && systemctl enable -q --now duniya-ops.path || return 1
    echo "Maintenance helper updated to version $newv ($tag)"
  else
    echo "The maintenance helper is already the one of $tag (version $newv)"
  fi
}
rollback() { # host message
  echo "Rolling back: $2"
  if [ -f "$STATE_DIR/Caddyfile.prev" ]; then
    install -m 0644 "$STATE_DIR/Caddyfile.prev" "$CADDYFILE"
    systemctl reload caddy 2>/dev/null || systemctl restart caddy 2>/dev/null || true
  fi
  web_status rolled-back "$2" "$1"
}

: > "$LOG"; chmod 644 "$LOG"
write_status running
export DEBIAN_FRONTEND=noninteractive
# needrestart (Ubuntu) only lists services to restart instead of asking or restarting them itself
export NEEDRESTART_MODE=l
APT=("$APT_GET" -y -q -o DPkg::Lock::Timeout=600 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)
NICE=(nice -n 10)
command -v ionice >/dev/null && NICE=(ionice -c3 nice -n 10)
{
  echo "== $ACTION started $(date -u +%FT%TZ)"
  case "$ACTION" in
    os-update) os_update ;;
    os-update-all) os_update phased ;;
    os-cleanup) "${APT[@]}" autoremove --purge && apt-get clean ;;
    restart-web) systemctl restart caddy && systemctl is-active caddy ;;
    restart-tunnel) systemctl restart cloudflared && systemctl is-active cloudflared ;;
    reboot) echo "Rebooting in 5 seconds"; true ;;
    apply-web-config) apply_web_config ;;
    update-helper) update_helper ;;
  esac
} >> "$LOG" 2>&1
CODE=$?
echo "== finished with code $CODE $(date -u +%FT%TZ)" >> "$LOG"
[ -f "$REBOOT_FILE" ] && echo "A reboot is required to finish the updates." >> "$LOG"
if [ $CODE -eq 0 ]; then write_status 'done' "$CODE"; else write_status failed "$CODE"; fi
if [ "$ACTION" = reboot ] && [ $CODE -eq 0 ]; then sleep 5; systemctl reboot; fi
exit 0
