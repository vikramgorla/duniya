{
  "name": "whatsapp-agent-duniya",
  "version": "2.1.1",
  "private": true,
  "description": "Self-hosted WhatsApp agent platform: many Claude-powered agents on one number, MCP tools, admin panel.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "test": "node --test --test-concurrency=1 --disable-warning=ExperimentalWarning test/*.test.js",
    "lint": "eslint .",
    "check:panel": "node -e \"const s=require('fs').readFileSync('src/panel/public/index.html','utf8');const m=[...s.matchAll(/<script>([\\s\\S]*?)<\\/script>/g)].pop();require('fs').writeFileSync('/tmp/panel-check.mjs',m[1])\" && node --check /tmp/panel-check.mjs",
    "check:responsive": "node --disable-warning=ExperimentalWarning scripts/check-responsive.mjs",
    "mobile": "npm --prefix mobile install --no-audit --no-fund && npm --prefix mobile start"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "baileys": "7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  }
}
