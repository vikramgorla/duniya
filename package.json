{
  "name": "duniya",
  "version": "2.46.0",
  "private": true,
  "description": "Self-hosted AI agents for WhatsApp and Telegram groups and chats: any model, MCP tools, People, events and orders, admin panel.",
  "license": "MIT",
  "repository": "github:vikramgorla/whatsapp-agent-duniya",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "test": "node --test --test-concurrency=4 --disable-warning=ExperimentalWarning test/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check:panel": "node --experimental-vm-modules --disable-warning=ExperimentalWarning scripts/check-panel.mjs",
    "check:responsive": "node --disable-warning=ExperimentalWarning scripts/check-responsive.mjs",
    "site:shots": "node --disable-warning=ExperimentalWarning scripts/site-shots.mjs",
    "measure:load": "node --disable-warning=ExperimentalWarning scripts/measure-load.mjs",
    "check:perf": "node --disable-warning=ExperimentalWarning scripts/check-perf.mjs",
    "measure:scale": "node --disable-warning=ExperimentalWarning scripts/measure-scale.mjs",
    "docs:diagrams": "node --disable-warning=ExperimentalWarning scripts/render-diagrams.mjs",
    "knip": "knip",
    "jscpd": "jscpd",
    "repo:sync": "node scripts/repo-sync.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "baileys": "7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "knip": "^6.45.1",
    "typescript": "^5.9.3"
  }
}
