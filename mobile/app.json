{
  "expo": {
    "name": "Duniya",
    "slug": "duniya",
    "scheme": "duniya",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f2f1ec",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vikramgorla.duniya",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.vikramgorla.duniya",
      "adaptiveIcon": {
        "backgroundColor": "#f2f1ec",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Duniya uses the camera only to scan the QR code shown in your panel (Settings → Mobile app).",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        { "faceIDPermission": "Duniya can ask for Face ID before showing your agents and chats." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
