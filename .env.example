# Docker Compose settings (copy to .env). Bare-metal installs use install.sh instead.
# Optional: create the owner account "admin" with this password (otherwise the setup code is in `docker compose logs app`)
ADMIN_PASSWORD=
# https profile: your domain (DNS must point to this machine)
DOMAIN=
PUBLIC_URL=
# tunnel profile: Cloudflare Tunnel token
TUNNEL_TOKEN=
TZ_DEFAULT=Europe/Zurich
